#!/usr/bin/env bash
set -u

hook_name="${1:?hook name required}"
current_hook="${2:?current hook path required}"
shift 2

common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || exit 0
if [[ "$common_dir" != /* ]]; then
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
  common_dir="$root/$common_dir"
fi

local_hook="$common_dir/hooks/$hook_name"
[[ -x "$local_hook" ]] || exit 0

if [[ "$local_hook" -ef "$current_hook" ]]; then
  exit 0
fi

"$local_hook" "$@"
