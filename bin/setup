#!/usr/bin/env bash
set -euo pipefail

# Find our parent directory
DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "==> Starting setup..."

# --- Homebrew ---
if ! command -v brew &>/dev/null; then
  echo "==> Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  echo "==> Homebrew already installed"
fi

# --- Homebrew packages ---
echo "==> Installing Homebrew packages..."
brew bundle --file="$DOTFILES_DIR/Brewfile"

# --- Symlink dotfiles ---
"$DOTFILES_DIR/bin/link-dotfiles"


# --- Copy templates to hard file ---
echo "==> Creating local overrides..."
if [[ ! -f "$HOME/.gitconfig.local" ]]; then
  cp "$DOTFILES_DIR/gitconfig.local.example" "$HOME/.gitconfig.local"
  echo "  Created ~/.gitconfig.local"
else
  echo "  Skipped ~/.gitconfig.local; file already exists"
fi
